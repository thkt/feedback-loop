{
  "name": "feedback-loop",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "test": "bun test ./tests --timeout 60000",
    "build:feedback-loop": "bun scripts/build.ts",
    "check:generated": "bun scripts/build.ts --check",
    "typecheck": "bun --check",
    "format": "bun fmt scripts src tests",
    "format:check": "bun fmt --check scripts src tests",
    "lint": "oxlint --deny-warnings scripts src tests",
    "complexity": "bun scripts/lint/fallow.ts health",
    "check:unused": "bun scripts/lint/fallow.ts dead-code",
    "check": "bun run lint && bun run format:check && bun run complexity && bun run typecheck && bun run check:unused && bun run check:generated && bun run check:classification && bun run test",
    "check:feedback": "bun run lint && bun run format:check && bun run complexity && bun run typecheck && bun run check:unused && bun run check:generated && bun run test:affected",
    "test:affected": "bun scripts/feedback-loop/runtime.mjs affected",
    "check:classification": "bun scripts/feedback-loop/runtime.mjs classification"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "fallow": "3.38.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
