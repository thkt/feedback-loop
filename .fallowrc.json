{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "scripts/lint/fallow.ts",
    "src/setup.ts",
    "src/runtime.ts",
    "scripts/build.ts"
  ],
  "includeEntryExports": true,
  "ignorePatterns": [
    "plugins/**",
    "scripts/feedback-loop/**"
  ],
  "ignoreDependencies": ["vitest"],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "complexity-cyclomatic": "off",
    "complexity-crap": "off"
  }
}
