{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "scripts/lint/fallow.ts",
    "scripts/list-tests.ts",
    "scripts/feedback-loop/setup.ts",
    "scripts/feedback-loop/runtime.ts",
    "scripts/feedback-loop/build.ts",
    "scripts/tests/support/host-process.ts"
  ],
  "includeEntryExports": true,
  "ignorePatterns": [
    "plugins/**"
  ],
  "ignoreDependencies": ["vitest"],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error"
  },
  "ignoreExports": [
    {
      "file": "scripts/tests/support/host-process.ts",
      "exports": [
        "*"
      ]
    }
  ]
}
